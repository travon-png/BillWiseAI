PORT=5001
APP_URL=http://localhost:5173
API_URL=http://localhost:5001
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Billing: use demo while testing; use polar for launch if Polar is your provider.
BILLING_PROVIDER=demo

# Polar subscriptions
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PLUS=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_FAMILY=

# Optional Stripe adapter
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FAMILY=

# Real email reminders. Leave SMTP_HOST blank until you have a real SMTP service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BillWise AI <reminders@yourdomain.com>
REMINDER_CRON=0 * * * *

# Plaid read-only bank sync
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=
# Example when your backend is public:
# PLAID_WEBHOOK_URL=https://api.yourdomain.com/api/bank/plaid/webhook?key=YOUR_RANDOM_WEBHOOK_KEY
PLAID_WEBHOOK_URL=
PLAID_WEBHOOK_SHARED_SECRET=

# 32-byte AES key for stored Plaid access tokens. Generate once with:
# openssl rand -hex 32
BANK_TOKEN_ENCRYPTION_KEY=
